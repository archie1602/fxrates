# Docker Compose PostgreSQL settings.
POSTGRES_DB=fxrates
POSTGRES_USER=fxrates
POSTGRES_PASSWORD=fxrates
POSTGRES_PORT=15432

# Host port published by Docker Compose. The container always listens on 8080.
HTTP_PORT=8080

# Used by local `make run`; Docker Compose sets the container address explicitly.
HTTP_ADDR=:8080
DATABASE_URL=postgres://fxrates:fxrates@localhost:15432/fxrates?sslmode=disable
DATABASE_TIMEOUT=5s
DATABASE_QUERY_TIMEOUT=3s
SHUTDOWN_TIMEOUT=10s

FRANKFURTER_BASE_URL=https://api.frankfurter.dev
FRANKFURTER_TIMEOUT=5s
# Allowed range: 1-10.
FRANKFURTER_MAX_ATTEMPTS=3
FRANKFURTER_RETRY_DELAY=250ms
FRANKFURTER_RETRY_MAX_DELAY=5s
# Allowed range: 1-32.
WORKER_COUNT=4
WORKER_POLL_INTERVAL=500ms
RECOVERY_INTERVAL=10s
# Must cover all provider attempts and retry delays plus the 5s safety margin.
PROCESSING_TIMEOUT=30s
